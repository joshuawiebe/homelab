# ===========================
# Traefik Environment
# ===========================
# BASE_DOMAIN: base domain shared by every service, e.g. example.com
BASE_DOMAIN=(put your base domain here)

# TRAEFIK_SUBDOMAIN: subdomain for the dashboard, e.g. traefik
TRAEFIK_SUBDOMAIN=(put your subdomain here)

# EMAIL: contact address used by ACME
EMAIL=(put your email here)

# IPV64_API_KEY: DNS API token used by the ACME DNS challenge
IPV64_API_KEY=(put your ipv64.net api key here)

# TRAEFIK_IMAGE: pin a version instead of tracking :latest
TRAEFIK_IMAGE=traefik:latest

# The dashboard password is not stored here: `homelab config` writes an
# htpasswd entry to services/traefik/users (mode 600, read-only mount).
